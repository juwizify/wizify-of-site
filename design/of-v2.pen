                      "content": "Obligatoire Qualiopi",
                      "fontFamily": "Poppins",
                      "fontSize": 12,
                      "fontWeight": "600"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "xuRad",
                  "name": "h2_1",
                  "fill": "#1A1A1A",
                  "content": "Règlement intérieur de formation",
                  "fontFamily": "Poppins",
                  "fontSize": 28,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "OVyyH",
                  "name": "intro1",
                  "fill": "#555555",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Le présent règlement intérieur s'applique à l'ensemble des stagiaires inscrits aux formations dispensées par OF Formation SAS, conformément aux articles L.6352-3 à L.6352-5 du Code du travail.",
                  "lineHeight": 1.6,
                  "fontFamily": "Poppins",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "gLfLD",
                  "name": "card1",
                  "width": "fill_container",
                  "fill": "#FFFFFF",
                  "cornerRadius": 12,
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#E8E9FF"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    28,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "Ct8AY",
                      "name": "card1h3",
                      "fill": "#1A1A1A",
                      "content": "Droits et obligations des stagiaires",
                      "fontFamily": "Poppins",
                      "fontSize": 20,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "wZAzi",
                      "name": "card1body",
                      "fill": "#555555",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• Le stagiaire s'engage à suivre la formation avec assiduité et ponctualité.\n• Il dispose d'un accès aux supports pédagogiques pour la durée de la formation.\n• Il bénéficie d'un accompagnement personnalisé par le formateur référent.\n• Il peut exercer son droit d'accès et de rectification sur ses données personnelles.\n• Le stagiaire s'interdit tout comportement portant atteinte au bon déroulement de la formation.",
                      "lineHeight": 1.6,
                      "fontFamily": "Poppins",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "GrCsT",
                  "name": "card2",
                  "width": "fill_container",
                  "fill": "#FFFFFF",
                  "cornerRadius": 12,
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#E8E9FF"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    28,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "LrhYM",
                      "name": "card2h3",
                      "fill": "#1A1A1A",
                      "content": "Modalités d'évaluation et de sanction",
                      "fontFamily": "Poppins",
                      "fontSize": 20,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "w9aKB",
                      "name": "card2body",
                      "fill": "#555555",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• Les acquis sont évalués par des quiz, des cas pratiques et une évaluation finale.\n• Un certificat de réalisation est délivré à l'issue de la formation.\n• Pour les formations certifiantes, une attestation de réussite est remise si le seuil de 70% est atteint.\n• En cas de manquement grave au règlement, le directeur pédagogique peut prononcer l'exclusion temporaire ou définitive du stagiaire.",
                      "lineHeight": 1.6,
                      "fontFamily": "Poppins",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "wcpZU",
                  "name": "card3",
                  "width": "fill_container",
                  "fill": "#FFFFFF",
                  "cornerRadius": 12,
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#E8E9FF"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    28,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "d5qyi",
                      "name": "card3h3",
                      "fill": "#1A1A1A",
                      "content": "Procédure en cas d'abandon ou d'annulation",
                      "fontFamily": "Poppins",
                      "fontSize": 20,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "4Yr1a",
                      "name": "card3body",
                      "fill": "#555555",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• En cas d'abandon en cours de formation, le stagiaire doit en informer l'Organisme par écrit.\n• Les frais engagés restent dus, sauf cas de force majeure dûment justifié.\n• En cas d'annulation par l'Organisme, le stagiaire est informé dans les meilleurs délais et peut choisir entre un report ou un remboursement intégral.",
                      "lineHeight": 1.6,
                      "fontFamily": "Poppins",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ixQtx",
                  "name": "card4",
                  "width": "fill_container",
                  "fill": "#FFFFFF",
                  "cornerRadius": 12,
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#E8E9FF"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    28,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "XCu9q",
                      "name": "card4h3",
                      "fill": "#1A1A1A",
                      "content": "Traitement des réclamations",
                      "fontFamily": "Poppins",
                      "fontSize": 20,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "hl5O1",
                      "name": "card4body",
                      "fill": "#555555",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• Toute réclamation doit être adressée par écrit à : reclamations@of-formation.fr\n• L'Organisme s'engage à accuser réception sous 48 heures ouvrées.\n• Une réponse argumentée est apportée dans un délai maximum de 15 jours ouvrés.\n• En cas de désaccord persistant, le stagiaire peut saisir le médiateur de la consommation désigné par l'Organisme.",
                      "lineHeight": 1.6,
                      "fontFamily": "Poppins",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
